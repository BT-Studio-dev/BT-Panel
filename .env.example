# BT Panel environment template
# Copy values into your deployment/environment settings.
# Do NOT commit a real .env file or real secrets.

# Authentication
# false = local/dev fallback when no DATABASE_URL is configured.
# true = real Better Auth / OAuth flow.
VITE_AUTH_ENABLED=false

# Production Better Auth values (required when VITE_AUTH_ENABLED=true)
# BETTER_AUTH_URL=https://panel.example.com
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database (PostgreSQL/Neon in production)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Pterodactyl integration
# Leave commented to run BT Panel without Pterodactyl connected.
# These are SERVER-ONLY values; never prefix them with VITE_.
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_CLIENT_API_KEY=ptlc_replace-with-client-api-key

# Optional OAuth broker configuration.
# GROK_AUTH_ISSUER=https://...
# GROK_AUTH_CLIENT_ID=...
# GROK_AUTH_CLIENT_SECRET=...
