# Copy to .env and replace placeholder values. Do not commit real secrets.
DATABASE_URL=postgresql://btpanel:CHANGE_ME@127.0.0.1:5432/btpanel
SEED_DEMO=false
COOKIE_SECURE=true
PORT=3000
PUBLIC_BASE_URL=https://panel.example.com

# Optional Pterodactyl 1.x integration.
# Use the origin only (no /api path). HTTPS is required outside localhost.
PTERODACTYL_URL=https://pterodactyl.example.com

# Create in Pterodactyl Admin -> Application API.
# This key can create servers and read node/server inventory. Keep it private.
PTERODACTYL_APPLICATION_TOKEN=

# Client API token for a dedicated Pterodactyl user that has access to the
# servers you want to monitor/control. It cannot control every server by
# default. Keep it private. This token is used for live resources/power.
PTERODACTYL_CLIENT_TOKEN=

# Minecraft panel module (Minecraft -> "Minecraft" in the sidebar, or /minecraft).
# Leave empty to embed the static design preview bundled in
# public/minecraft-panel (regenerate with: npm run sync:minecraft-preview).
# Point it at the PHP panel's origin to embed the live panel instead, e.g.
# NEXT_PUBLIC_MINECRAFT_PANEL_URL=https://mc.example.com
NEXT_PUBLIC_MINECRAFT_PANEL_URL=
